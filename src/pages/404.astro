---
import Layout from "@/layouts/Layout.astro";
import { Icon } from "astro-icon/components";
---

<Layout title="404" description="Page not found" class="flex items-center justify-center">
  <section class="w-full pb-12 pt-8 text-center" aria-labelledby="not-found-heading">
    <p class="display-title not-found-code">404</p>
    <h1 id="not-found-heading" class="page-title">Page not found</h1>

    <div class="intro-links justify-center">
      <a href="/" class="text-link">
        <span class="text-link-label">
          <Icon name="carbon:arrow-left" size={16} aria-hidden="true" />
          Return home
        </span>
      </a>
    </div>
  </section>
</Layout>
