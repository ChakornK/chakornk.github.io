---
import Layout from "@/layouts/Layout.astro";

import type { GetStaticPaths } from "astro";
import ProjectLinks from "@/components/ProjectLinks.astro";
import ChipList from "@/components/ChipList.astro";
import TechStack from "@/components/TechStack.astro";

const projects = import.meta.glob("/content/{projects,projects-hackathon}/*.md", { eager: true });
const project = Object.entries(projects).find(([k, p]) => k.split("/").slice(-1)[0].split("-").slice(1).join("-").split(".")[0] === Astro.params.id)![1];
const { Content, frontmatter } = project as Record<string, any>;
const projectId = Astro.params.id;

export const getStaticPaths = (() => {
  const matches = import.meta.glob("/content/{projects,projects-hackathon}/*.md", { eager: true });
  const projects = Object.keys(matches).map((p) => p.split("/").slice(-1)[0].split("-").slice(1).join("-").split(".")[0]);
  return projects.map((p) => ({ params: { id: p } }));
}) satisfies GetStaticPaths;
---

<Layout title={frontmatter.name} description={frontmatter.description} class="project-page">
  <div class="bg-background pointer-events-none fixed inset-0 top-14 -z-10 opacity-0" data-project-bg={projectId}></div>
  <div id="project-header" class="sticky top-14 z-20 flex flex-col-reverse pb-2 transition-all duration-200 sm:flex-row">
    <div class="h-px w-full sm:h-auto sm:w-px" data-project-img={projectId}></div>
    <div class="relative w-full">
      {/* Sizing placeholder */}
      <div aria-hidden="true" class="invisible">
        <div class="project-title-row">
          <p class="page-title">{frontmatter.name}</p>
          <div><ProjectLinks {...frontmatter} /></div>
        </div>
        <div class="project-summary-block">
          <p class="project-summary">{frontmatter.description}</p>
        </div>
        <ChipList awards={frontmatter.awards?.split(/, ?/)} skills={frontmatter.skills?.split(/, ?/)} />
      </div>

      {/* Overlap the sticky edges by a pixel to cover subpixel seams. */}
      <div class="absolute left-0 right-0 top-0 -mx-px -translate-y-px" id="project-header-visible">
        <div class="project-title-row bg-background">
          <h1 class="page-title transition-[font-size] duration-200" data-project-title={projectId}>
            {frontmatter.name}
          </h1>
          <div data-project-links={projectId}><ProjectLinks {...frontmatter} /></div>
        </div>
        <div class="project-summary-block bg-background">
          <p class="project-summary transition-[font-size]" data-project-desc={projectId}>
            {frontmatter.description}
          </p>
        </div>
        <div id="project-header-collapse" class="relative transition-opacity duration-200">
          <div class="bg-background absolute left-0 top-0 flex h-full w-full items-center overflow-hidden transition-[height]" id="project-header-collapse-bg">
            <div class="z-10" data-project-chips={projectId}>
              <ChipList awards={frontmatter.awards?.split(/, ?/)} skills={frontmatter.skills?.split(/, ?/)} projectId={projectId} />
            </div>
          </div>
          <div aria-hidden="true" class="invisible">
            <ChipList awards={frontmatter.awards?.split(/, ?/)} skills={frontmatter.skills?.split(/, ?/)} />
          </div>
        </div>
      </div>
    </div>
  </div>
  <div
    id="project-content"
    class="prose prose-slate prose-li:marker:text-inherit prose-img:max-h-96 prose-img:max-w-full prose-img:object-contain animate-delay-100 animate-fill-both relative z-10"
  >
    <Content />
    {frontmatter.stack && Object.values(frontmatter.stack).some((items) => Array.isArray(items) && items.length > 0) && (
      <section aria-labelledby="tech-stack">
        <h2 id="tech-stack">Tech stack</h2>
        <div class="not-prose">
          <TechStack stack={frontmatter.stack} />
        </div>
      </section>
    )}
  </div>
</Layout>
