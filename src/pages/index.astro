---
import Layout from "@/layouts/Layout.astro";
import { Icon } from "astro-icon/components";

import ChipList from "@/components/ChipList.astro";
// @ts-ignore
import experienceData from "../../content/experience.yml";
const bio = experienceData.bio as string;
const experience = experienceData.experience as { title: string; date: string; description: string[]; awards?: string[]; skills?: string[] }[];
const stack = experienceData.stack as { [title: string]: { name: string; icon: string; color: string; link: string }[] };

const formatExperienceDate = (date: string) =>
  date.replace(/\b\d{2}(\d{2})\b/g, "'$1").replace(/\bPresent\b/gi, "Now");

const getColor = (color: string) => {
  switch (color) {
    case "red":
      return "hover:bg-red-400/16";
    case "orange":
      return "hover:bg-orange-400/16";
    case "yellow":
      return "hover:bg-yellow-400/16";
    case "green":
      return "hover:bg-green-400/16";
    case "emerald":
      return "hover:bg-emerald-400/16";
    case "cyan":
      return "hover:bg-cyan-400/16";
    case "sky":
      return "hover:bg-sky-400/16";
    case "blue":
      return "hover:bg-blue-400/16";
    case "violet":
      return "hover:bg-violet-400/16";
    case "pink":
      return "hover:bg-pink-400/16";
    case "neutral":
      return "hover:bg-stone-400/16";
  }
};

import ProjectCard from "@/components/ProjectCard.astro";
// @ts-ignore
import featuredProjectList from "../../content/featured-projects.yml";
const projectMatches = import.meta.glob("/content/projects/*.md", { eager: true });
const featuredProjects1 = Object.entries(projectMatches).map(([k, p]) => ({
  id: k.split("/").slice(-1)[0].split(".")[0].split("-").slice(1).join("-"),
  ...(p as { frontmatter: any }).frontmatter,
})) as Record<string, any>[];
const projectMatches2 = import.meta.glob("/content/projects-hackathon/*.md", { eager: true });
const featuredProjects2 = Object.entries(projectMatches2).map(([k, p]) => ({
  id: k.split("/").slice(-1)[0].split(".")[0].split("-").slice(1).join("-"),
  ...(p as { frontmatter: any }).frontmatter,
})) as Record<string, any>[];

const featuredProjectsCombined = [...featuredProjects1, ...featuredProjects2];
const featuredProjects = featuredProjectList.featured.map((id: string) => featuredProjectsCombined.find((p) => p.id === id)) as Record<string, any>[];
---

<Layout class="page-flow" fadein page="home">
  <header>
    <p class="intro-greeting">Hello, I'm</p>
    <h1 class="display-title">Chakorn Kungsanarux</h1>

    <div class="intro-bio">
      {bio.trim().split(/\n\s*\n/).map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <nav class="intro-links" aria-label="Social links">
      <a href="https://github.com/ChakornK" class="text-link" target="_blank" rel="noopener noreferrer">
        <span class="text-link-label">GitHub <span aria-hidden="true">↗</span></span>
      </a>
      <a href="https://www.linkedin.com/in/chakorn-kungsanarux" class="text-link" target="_blank" rel="noopener noreferrer">
        <span class="text-link-label">LinkedIn <span aria-hidden="true">↗</span></span>
      </a>
      <a href="https://devpost.com/chakornk" class="text-link" target="_blank" rel="noopener noreferrer">
        <span class="text-link-label">Devpost <span aria-hidden="true">↗</span></span>
      </a>
    </nav>
  </header>

  <section class="page-section" aria-labelledby="featured-heading">
    <div class="section-heading-row">
      <h2 id="featured-heading" class="section-title">Featured Projects</h2>
      <a href="/projects" class="text-link">
        <span class="text-link-label">
          View all
          <Icon name="carbon:arrow-right" size={16} aria-hidden="true" />
        </span>
      </a>
    </div>
    <div class="project-list">
      {featuredProjects.map((project) => <ProjectCard {project} />)}
    </div>
  </section>

  <section class="page-section" aria-labelledby="experience-heading">
    <h2 id="experience-heading" class="section-title">Experience</h2>
    <div class="experience-list">
      {
        experience.map((item) => {
          const [role, ...organization] = item.title.split(" @ ");
          const employer = organization.join(" @ ");
          return (
            <article class="experience-entry">
              <header>
                <h3 class="entry-title">{employer || role}</h3>
                <div class="experience-meta">
                  {employer && <p class="experience-role">{role}</p>}
                  <p class="meta-text experience-date" title={item.date}>{formatExperienceDate(item.date)}</p>
                </div>
                <ChipList awards={item.awards} skills={item.skills} />
              </header>
              <ul class="experience-description">
                {item.description.map((desc) => <li>{desc}</li>)}
              </ul>
            </article>
          );
        })
      }
    </div>
  </section>

  <section class="page-section" aria-labelledby="skills-heading">
    <h2 id="skills-heading" class="section-title">Technical Skills</h2>
    <dl class="skills-list">
      {
        Object.entries(stack).map(([title, items]) => (
          <div class="skill-group">
            <dt class="skill-label">{title}</dt>
            <dd class="skill-items">
              {items.map(({ name, icon, color, link }: { name: string; icon: string; color: string; link: string }) => (
                <a href={link} target="_blank" rel="noopener noreferrer" class={`skill-chip rounded-full bg-surface transition-colors ${getColor(color)}`}>
                  <Icon name={icon} size={16} aria-hidden="true" />
                  <span>{name}</span>
                </a>
              ))}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="page-section" aria-labelledby="contributions-heading">
    <h2 id="contributions-heading" class="section-title">GitHub Contributions</h2>
    <div id="git-contributions" class="*:w-2xl direction-rtl overflow-x-auto"></div>
    <p id="git-contributions-label" class="meta-text mt-2"></p>
  </section>
</Layout>

<script src="../scripts/animate.ts"></script>

<style is:global>
  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    .intro-fadein main[data-page="home"] > * {
      opacity: 0;
      transition: opacity 300ms ease;
      contain: content;
    }
    body:not(.intro-fadein) main[data-page="home"] > * {
      opacity: 1 !important;
      transition: none !important;
      contain: none !important;
    }
  }
</style>
