---
import { Icon } from "astro-icon/components";
// @ts-ignore
import technologyData from "../../content/technologies.yml";

interface Props {
  stack: Record<string, string[]>;
}

interface Technology {
  icon?: string;
  color?: string;
  link?: string;
}

const { stack } = Astro.props;
const technologies = technologyData as Record<string, Technology>;
const hoverColors: Record<string, string> = {
  red: "hover:bg-red-400/16",
  orange: "hover:bg-orange-400/16",
  yellow: "hover:bg-yellow-400/16",
  green: "hover:bg-green-400/16",
  emerald: "hover:bg-emerald-400/16",
  cyan: "hover:bg-cyan-400/16",
  sky: "hover:bg-sky-400/16",
  blue: "hover:bg-blue-400/16",
  violet: "hover:bg-violet-400/16",
  pink: "hover:bg-pink-400/16",
  neutral: "hover:bg-stone-400/16",
};
---

<dl class="skills-list">
  {
    Object.entries(stack).filter(([, items]) => items.length > 0).map(([title, items]) => (
      <div class="skill-group">
        <dt class="skill-label">{title}</dt>
        <dd class="skill-items">
          {items.map((name) => {
            const { icon = "carbon:code", color = "neutral", link } = technologies[name] ?? {};
            const Tag = link ? "a" : "span";
            return (
              <Tag
                href={link}
                target={link ? "_blank" : undefined}
                rel={link ? "noopener noreferrer" : undefined}
                class={`skill-chip rounded-full bg-surface transition-colors ${link ? hoverColors[color] ?? hoverColors.neutral : ""}`}
              >
                <Icon name={icon} size={16} aria-hidden="true" />
                <span>{name}</span>
              </Tag>
            );
          })}
        </dd>
      </div>
    ))
  }
</dl>
